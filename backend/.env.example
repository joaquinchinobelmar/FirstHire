# Copy this file to backend/.env and fill in what you have.
# Everything is optional: without keys the app runs in "offline demo mode"
# (rule-based AI fallbacks + a synthetic Companies House snapshot).

# --- Claude (Anthropic API) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high  (medium is a good speed/quality balance for a live demo)
CLAUDE_EFFORT=medium
# auto = use Claude when a key is present, offline = never call Claude
AI_MODE=auto

# --- Companies House Public Data API (free key: https://developer.company-information.service.gov.uk/) ---
COMPANIES_HOUSE_API_KEY=

# --- Security ---
SESSION_TTL_HOURS=12
# Set to true when served over HTTPS
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
